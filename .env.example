# OpenRouter key (https://openrouter.ai/keys). Leave empty to rehearse in fake mode (the "AI" just tints photos).
OPENROUTER_API_KEY=
# PIN student helpers use to unlock the booth on an iPad and to open Setup.
BOOTH_PIN=2468
# 32+ random characters, e.g. `openssl rand -base64 48`.
SESSION_SECRET=
# Where photos are kept (at most 1 hour). On Railway, mount a volume here.
DATA_DIR=./data
# The public address used in QR codes. Railway: your https://<name>.up.railway.app domain.
PUBLIC_URL=http://localhost:3000
# Optional
# SEEDREAM_MODEL=bytedance-seed/seedream-5-0-flash
# MAX_SHOTS_PER_HOUR=150
# Local time zone for the dates printed on Magazine covers and Polaroids.
# TZ=Asia/Singapore
